<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; padding: 15px; }
    h2 { color: #2c5f2d; text-align: center; }
    .topbar { display: flex; justify-content: space-between; align-items: center; max-width: 700px; margin: 0 auto 15px; }
    a.btn { background: #2c5f2d; color: white; padding: 10px 18px; border-radius: 8px; text-decoration: none; }
    table { width: 100%; max-width: 700px; margin: 0 auto; border-collapse: collapse; background: white; }
    th, td { padding: 10px; border: 1px solid #ddd; text-align: center; font-size: 14px; }
    th { background: #2c5f2d; color: white; }
    .count { text-align: center; color: #555; margin-bottom: 10px; }
  </style>
</head>
<body>
  <h2>📋 Admin Dashboard</h2>
  <p class="count">एकूण घरं: <b><%= residents.length %></b></p>
  <div class="topbar">
    <a href="/admin/add" class="btn">+ नवीन घर ॲड करा</a>
    <a href="/admin/logout" class="btn" style="background:#888;">लॉगआउट</a>
  </div>
  <table>
    <tr><th>अ.क्र</th><th>मिळकत नं</th><th>मालकाचे नाव</th></tr>
    <% residents.forEach((r, i) => { %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= r.property_no %></td>
        <td><%= r.owner_name %></td>
      </tr>
    <% }) %>
  </table>
</body>
</html>
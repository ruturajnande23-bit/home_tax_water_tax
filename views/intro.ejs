<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>गाव कर व्यवस्थापन</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; text-align: center; padding: 20px; }
    h1 { color: #2c5f2d; }
    .officials { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; margin: 30px 0; }
    .official { background: white; border-radius: 10px; padding: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); width: 140px; }
    .official img { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; }
    .official p { margin: 8px 0 0; font-weight: bold; color: #333; }
    a.btn { display: inline-block; margin-top: 30px; background: #2c5f2d; color: white; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-size: 18px; }
  </style>
</head>
<body>
  <h1>🏡 ग्रामपंचायत कर व्यवस्थापन</h1>
  <div class="officials">
    <div class="official">
      <img src="/images/sarpanch.jpg">
      <p>सरपंच</p>
    </div>
    <div class="official">
      <img src="/images/upsarpanch.jpg">
      <p>उपसरपंच</p>
    </div>
    <div class="official">
      <img src="/images/gramsevak.jpg">
      <p>ग्रामसेवक</p>
    </div>
  </div>
  <a href="/login" class="btn">पुढे जा</a>
</body>
</html>
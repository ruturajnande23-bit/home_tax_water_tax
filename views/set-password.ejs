<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password सेट करा</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; text-align: center; padding: 50px 20px; }
    h2 { color: #2c5f2d; }
    p.note { color: #555; max-width: 320px; margin: 0 auto; }
    form { background: white; max-width: 320px; margin: 20px auto; padding: 25px; border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    input { width: 100%; padding: 12px; margin: 10px 0; border: 1px solid #ccc; border-radius: 6px; font-size: 16px; box-sizing: border-box; }
    .pwd-box { position: relative; }
    .pwd-box input { padding-right: 45px; }
    .pwd-box span { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); cursor: pointer; font-size: 18px; user-select: none; }
    button { width: 100%; padding: 12px; background: #2c5f2d; color: white; border: none; border-radius: 6px; font-size: 16px; cursor: pointer; }
    .error { color: red; margin-top: 10px; }
    a { display: block; margin-top: 15px; color: #555; text-decoration: none; }
  </style>
</head>
<body>
  <h2>🆕 पहिल्यांदा Password सेट करा</h2>
  <p class="note">प्रथमच वापरत असाल तर आधी इथे तुमचा स्वतःचा password तयार करा</p>
  <form action="/set-password" method="POST">
    <input type="text" name="property_no" placeholder="मिळकत नंबर" required>
    <div class="pwd-box">
      <input type="password" name="new_password" id="pwdField" placeholder="नवीन Password तयार करा" required>
      <span onclick="togglePwd()">👁️</span>
    </div>
    <button type="submit">Password सेव्ह करा</button>
  </form>
  <% if (typeof error !== 'undefined' && error) { %>
    <p class="error"><%= error %></p>
  <% } %>
  <a href="/login">आधीच Password सेट आहे? इथे लॉगिन करा →</a>

  <script>
    function togglePwd() {
      const field = document.getElementById('pwdField');
      field.type = field.type === 'password' ? 'text' : 'password';
    }
  </script>
</body>
</html>
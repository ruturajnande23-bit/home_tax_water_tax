<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>नवीन घर ॲड करा</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; padding: 15px; }
    h2 { color: #2c5f2d; text-align: center; }
    form { background: white; max-width: 480px; margin: 0 auto; padding: 20px; border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    label { display: block; margin-top: 12px; font-size: 14px; color: #333; font-weight: bold; }
    input { width: 100%; padding: 10px; margin-top: 4px; border: 1px solid #ccc; border-radius: 6px; font-size: 15px; box-sizing: border-box; }
    .row { display: flex; gap: 10px; }
    .row > div { flex: 1; }
    button { width: 100%; padding: 12px; margin-top: 20px; background: #2c5f2d; color: white; border: none; border-radius: 6px; font-size: 16px; cursor: pointer; }
    .error { color: red; text-align: center; margin-top: 10px; }
    .back { display: block; text-align: center; margin-top: 12px; color: #555; text-decoration: none; }
    h4 { margin-top: 20px; margin-bottom: 5px; color: #2c5f2d; border-bottom: 1px solid #ddd; padding-bottom: 5px; }
  </style>
</head>
<body>
  <h2>➕ नवीन घर ॲड करा</h2>
  <form action="/admin/add" method="POST">
    <label>मिळकत नंबर</label>
    <input type="text" name="property_no" placeholder="उदा. 104" required>

    <label>मालकाचे नाव</label>
    <input type="text" name="owner_name" placeholder="पूर्ण नाव" required>

    <h4>घरपट्टी कर</h4>
    <div class="row">
      <div><label>मागील</label><input type="number" step="0.01" name="gharpatti_magil" value="0"></div>
      <div><label>चालू</label><input type="number" step="0.01" name="gharpatti_chalu" value="0"></div>
    </div>

    <h4>दिवाबत्ती कर</h4>
    <div class="row">
      <div><label>मागील</label><input type="number" step="0.01" name="divabatti_magil" value="0"></div>
      <div><label>चालू</label><input type="number" step="0.01" name="divabatti_chalu" value="0"></div>
    </div>

    <h4>आरोग्य कर</h4>
    <div class="row">
      <div><label>मागील</label><input type="number" step="0.01" name="arogya_magil" value="0"></div>
      <div><label>चालू</label><input type="number" step="0.01" name="arogya_chalu" value="0"></div>
    </div>

    <h4>सामान्य पाणीपट्टी</h4>
    <div class="row">
      <div><label>मागील</label><input type="number" step="0.01" name="samanya_pani_magil" value="0"></div>
      <div><label>चालू</label><input type="number" step="0.01" name="samanya_pani_chalu" value="0"></div>
    </div>

    <h4>विशेष पाणीपट्टी</h4>
    <div class="row">
      <div><label>मागील</label><input type="number" step="0.01" name="vishesh_pani_magil" value="0"></div>
      <div><label>चालू</label><input type="number" step="0.01" name="vishesh_pani_chalu" value="0"></div>
    </div>

    <button type="submit">घर सेव्ह करा</button>
  </form>
  <a href="/admin/dashboard" class="back">← मागे जा</a>

  <% if (typeof error !== 'undefined' && error) { %>
    <p class="error"><%= error %></p>
  <% } %>
</body>
</html>